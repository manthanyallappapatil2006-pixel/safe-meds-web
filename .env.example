# Safe Meds Healthcare Platform — Environment Configuration Template
# Duplicate this file to .env and provide your project credentials.

# 1. Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. AI Healthcare Assistant Proxy Endpoint (Optional)
# In production, point to your secure backend API proxy to avoid frontend key exposure.
VITE_AI_ENDPOINT=/api/ai-chat

# 3. Environment Indicator
VITE_APP_ENV=development
