# Safe Meds Healthcare Platform — Environment Configuration Template
# Duplicate this file to .env and configure your project credentials.

# 1. Custom Node.js + Express Backend API (Section 15 Backend Integration)
# Use this to connect to your teammate's local or deployed Express backend.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# In production:
# VITE_API_BASE_URL=https://api.safemeds.com/api/v1
VITE_API_KEY=your-client-api-key-here

# 2. Supabase PostgreSQL & Real OAuth Authentication (Section 4 & 16)
# Enable Google provider in Supabase Auth Settings to activate Google Sign-In.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Environment Indicator
VITE_APP_ENV=development
